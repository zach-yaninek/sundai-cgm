# Data cache. The loaders fetch into ~/.cgm_cache by default, but $CGM_CACHE
# may point inside the repo — never commit the source data or the photos.
.cgm_cache/
photos/
*.zip
*.jpg

# artifacts/ IS committed: it is what the webapp reads. Ignore stray parquet
# elsewhere, then explicitly re-include the artifact files.
*.parquet
!artifacts/*.parquet
!artifacts/**/*.parquet

__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.DS_Store

# frontend build output and deps (web/ has its own .gitignore too)
web/node_modules/
web/dist/

# Added by `vercel link`. Scoped narrower than the .env* it writes by default,
# which would also hide web/.env.example - a file that is meant to be read.
.vercel
.env.local
.env*.local
